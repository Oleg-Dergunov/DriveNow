<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DriveNow</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="cars">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Cars
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="bookings">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Bookings
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="locations">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Locations
                    </NavLink>
                </div>

                <div class="nav-item px-3 mt-3 text-white-50 small">
                    Signed in as <strong class="text-white">@context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</strong>
                    <div>@(context.User.IsInRole(AppUser.AdminRole) ? "Administrator" : "Staff")</div>
                </div>

                <div class="nav-item px-3">
                    <form action="logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link btn btn-link text-start w-100">
                            <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>